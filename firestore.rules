rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Like ps-enterprises-swart: any logged-in staff can use the shop
    function isSignedIn() {
      return request.auth != null;
    }

    // Shared shop data (products, invoices, customers — one doc for whole team)
    match /business/{docId} {
      allow read, write: if isSignedIn();
    }

    // Customer short invoice links (public open, staff write)
    match /shares/{shareId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Old path (migration)
    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
